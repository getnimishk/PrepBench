# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local credential store for AI providers. Holds the user's API keys
# (obfuscated) and the machine-local key used to obfuscate them -- must never
# be tracked, on any machine.
backend/data/.llm_secrets.json
backend/data/.llm_secret_key

# Databases
#
# Repo-wide rather than backend/data only. A stray exam_simulator.db turned up
# at the repo root, where the old pattern did not reach it, so git offered it
# for commit like source. The application only ever writes to backend/data, so
# a .db anywhere else is an accident by definition and none is tracked.
*.db
*.db-journal
*.db-wal
*.db-shm

# Models this machine's Ollama catalogue sync discovered. The shipped
# catalogue is backend/app/data/local_models.json, tracked; this is local state.
backend/data/local_models.custom.json

# Personal audio recordings
backend/data/recordings/
# Recordings made by the browser tests
backend/data/e2e_recordings/
backend/data/e2e_secrets/

# Logs
logs/
*.log

# Node / frontend
node_modules/
frontend/dist/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code config and instructions -- local to each machine, not project
# source. CLAUDE.md carries session-to-session notes and standing instructions
# for whoever's working on this machine; it isn't meant to be reviewed as a
# diff or shared through the repo.
.claude/
CLAUDE.md

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage/

# Playwright output. Traces and screenshots from failed browser tests; useful
# locally, noise in a diff.
frontend/playwright-report/
frontend/test-results/
