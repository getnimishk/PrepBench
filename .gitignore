# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local credential store for AI providers. Holds the user's API keys
# (obfuscated) and the machine-local key used to obfuscate them -- must never
# be tracked, on any machine.
backend/data/.llm_secrets.json
backend/data/.llm_secret_key

# Databases
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# Personal audio recordings
backend/data/recordings/

# Logs
logs/
*.log

# Node / frontend
node_modules/
frontend/dist/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code config (tool-specific, not project source)
.claude/
