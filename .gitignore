# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local credential store for AI providers. Holds the user's API keys
# (obfuscated) and the machine-local key used to obfuscate them -- must never
# be tracked, on any machine.
backend/data/.llm_secrets.json
backend/data/.llm_secret_key

# Databases
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# Models this machine's Ollama catalogue sync discovered. The shipped
# catalogue is backend/app/data/local_models.json, tracked; this is local state.
backend/data/local_models.custom.json

# Personal audio recordings
backend/data/recordings/
# Recordings made by the browser tests
backend/data/e2e_recordings/
backend/data/e2e_secrets/

# Logs
logs/
*.log

# Node / frontend
node_modules/
frontend/dist/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code config (tool-specific, not project source)
.claude/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage/

# Playwright output. Traces and screenshots from failed browser tests; useful
# locally, noise in a diff.
frontend/playwright-report/
frontend/test-results/
