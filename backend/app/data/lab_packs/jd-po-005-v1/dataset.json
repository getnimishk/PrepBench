  "defects": [
    {
      "id": "aed-rounding",
      "kind": "precision",
      "table": "defects",
      "column": "repair_cost_aed",
      "legacy_scale": 2,
      "affects": {
        "count": 180
      },
      "about": "The legacy job rounded repair costs to two decimals, whole fils, for some shipments; the migrated job keeps four, so the amounts differ by fractions of a fils and a sum over many rows drifts."
    },
    {
      "id": "gulf-time",
      "kind": "timezone",
      "table": "defects",
      "column": "inspected_at",
      "legacy_offset_hours": 4,
      "affects": {
        "fraction": 0.12
      },
      "about": "Rows written by one legacy job took the cluster's local time (Gulf Standard Time, UTC+4) as if it were UTC."
    },
    {
      "id": "null-scrap",
      "kind": "null_handling",
      "table": "defects",
      "column": "scrap_qty",
      "legacy_value": 0,
      "affects": {
        "count": 24
      },
      "about": "Scrap not yet counted is unknown (null) in the source; the legacy job wrote 0, which changes the average but not the row count."
    },
