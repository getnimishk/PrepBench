# Project Name & Version
PROJECT_NAME="PrepBench"
VERSION="1.0.0"
LOG_LEVEL="DEBUG"

# ---------------------------------------------------------------------------
# AI provider configuration
# ---------------------------------------------------------------------------
# PrepBench is vendor-agnostic: AI features run against a local model on your
# own machine (llamafile, Ollama, LM Studio) or a cloud API (Gemini, OpenAI,
# Anthropic, or anything OpenAI-compatible). Which one is used is stored in the
# database, not here.
#
# This variable remains supported for backward compatibility. On first start,
# if it is set and no provider has been configured yet, PrepBench imports it as
# a provider named "Gemini (from environment)". The key is NOT copied into the
# database -- only a reference to this variable is stored, so it stays here.
#
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Selects which recording-analysis pipeline handles interview audio.
# Defaults to "default", which delegates to your configured AI provider.
# RECORDING_ANALYSIS_PROVIDER=default

# To add a provider PrepBench does not ship a profile for, create
# backend/data/llm_profiles.custom.json using the same shape as
# backend/app/data/llm_profiles.json. No code change is required.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Defaults to a local SQLite database in data/exam_simulator.db
# DATABASE_PATH="data/exam_simulator.db"

# NOTE: exam defaults (passing percentage, duration, question count) are NOT
# configured here. They live in the app_settings table and are edited from the
# Settings page, which is the only place the app reads them from.
