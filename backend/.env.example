# Project Name & Version
PROJECT_NAME="Local Offline Exam Simulator"
VERSION="1.0.0"
LOG_LEVEL="DEBUG"

# Optional: Google Gemini API Key for LLM Content Validation & RAG Research Assistant
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Defaults to local SQLite database in data/exam_simulator.db)
# DATABASE_PATH="data/exam_simulator.db"

# Exam Configuration Defaults
DEFAULT_PASSING_PERCENTAGE=70.0
DEFAULT_EXAM_DURATION_MINUTES=60
DEFAULT_QUESTIONS_PER_EXAM=25
